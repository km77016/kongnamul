# gunicorn을 systemd 서비스로 등록하는 예시 파일이에요.
#
# 사용법 (Ubuntu/Debian 기준):
#   1. 아래 경로들(/opt/kongnamul, User=www-data 등)을 실제 서버 환경에 맞게 고치세요.
#   2. sudo cp kongnamul.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now kongnamul
#   5. 로그 확인: sudo journalctl -u kongnamul -f
#
# ⚠️ 워커는 반드시 1개(-w 1)로 두세요. 이 앱은 SQLite + 인메모리 시세갱신 스케줄러를
# 쓰기 때문에, 워커를 여러 개로 늘리면 스케줄러가 중복 실행되고 SQLite 동시쓰기 경합도
# 늘어나요. 대신 --threads로 동시 요청 처리량을 늘리세요 (스레드는 프로세스를 공유해서
# 스케줄러가 중복되지 않아요).

[Unit]
Description=Kongnamul (콩나물) Flask app via gunicorn
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/kongnamul
EnvironmentFile=/opt/kongnamul/.env
# .env 파일은 python-dotenv 없이 app.py의 os.environ.get()이 직접 읽지 않으니,
# systemd의 EnvironmentFile 기능으로 환경변수를 주입해요 (KEY=VALUE 형식 그대로 사용 가능).
ExecStart=/opt/kongnamul/venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --bind 127.0.0.1:5000 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

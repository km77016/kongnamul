# nginx 리버스 프록시 설정 예시예요. 도메인/경로는 실제 환경에 맞게 바꾸세요.
#
# 사용법:
#   1. 아래에서 your-domain.com 을 실제 도메인으로 바꾸세요.
#   2. sudo cp nginx.conf.example /etc/nginx/sites-available/kongnamul
#   3. sudo ln -s /etc/nginx/sites-available/kongnamul /etc/nginx/sites-enabled/
#   4. sudo nginx -t   (문법 검사)
#   5. sudo systemctl reload nginx
#   6. HTTPS 인증서 발급: sudo certbot --nginx -d your-domain.com
#      (certbot이 아래 설정을 자동으로 HTTPS용으로 고쳐줘요)

server {
    listen 80;
    server_name your-domain.com;

    # gunicorn(127.0.0.1:5000)으로 요청을 넘겨줘요
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /api/stream, /api/admin/stream 은 SSE(Server-Sent Events)라서
    # nginx가 응답을 버퍼링하지 않고 바로바로 흘려보내도록 꺼줘야 실시간 알림이 지연 없이 동작해요.
    location /api/stream {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding off;
    }

    location /api/admin/stream {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding off;
    }

    client_max_body_size 5m;
}
